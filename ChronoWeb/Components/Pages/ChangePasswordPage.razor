@page "/change-password"
@using ChronoWeb.Services
@inject AppState AppState
@inject ApiService ApiService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>CHRONO – Passwort ändern</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;background:var(--l0);">

    @if (!_initialized)
    {
        <div class="cp-loading">
            <div class="spinner"></div>
        </div>
    }
    else
    {
        <div class="card" style="width:100%;max-width:440px;">
            <div class="card-body">

                <div class="cp-logo">
                    <img src="/chrono-logo.png" alt="CHRONO" />
                </div>

                <div class="cp-header">
                    <h1 class="page-title" style="text-align:center;font-size:22px;">Passwort ändern</h1>
                    <p>
                        @if (AppState.MustChangePassword)
                        {
                            <span>Du verwendest noch ein temporäres Passwort. Bitte wähle jetzt ein persönliches Passwort.</span>
                        }
                        else
                        {
                            <span>Hier kannst du dein Passwort jederzeit ändern.</span>
                        }
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(successMsg))
                {
                    <div class="alert alert-ok">@successMsg</div>
                }

                @if (!string.IsNullOrEmpty(errorMsg))
                {
                    <div class="alert alert-err">@errorMsg</div>
                }

                <div class="stack">

                    <div class="field">
                        <span class="field-label">Aktuelles Passwort</span>
                        <input type="password" @bind="oldPassword" class="input"
                               placeholder="Dein aktuelles Passwort" />
                    </div>

                    <div class="field">
                        <span class="field-label">Neues Passwort</span>
                        <input type="password" @bind="newPassword" @bind:event="oninput"
                               class="input" placeholder="Mind. 8 Zeichen, 1 Zahl, 1 Sonderzeichen" />

                        @if (!string.IsNullOrEmpty(newPassword))
                        {
                            <div class="strength-bar">
                                <div class="strength-seg @(PasswordStrength >= 1 ? GetStrengthColor(1) : "seg-empty")"></div>
                                <div class="strength-seg @(PasswordStrength >= 2 ? GetStrengthColor(2) : "seg-empty")"></div>
                                <div class="strength-seg @(PasswordStrength >= 3 ? GetStrengthColor(3) : "seg-empty")"></div>
                            </div>
                            <div class="strength-label @GetStrengthColor(PasswordStrength)">
                                @GetStrengthText(PasswordStrength)
                            </div>
                        }
                    </div>

                    <div class="field" style="margin-bottom:0;">
                        <span class="field-label">Neues Passwort bestätigen</span>
                        <input type="password" @bind="confirmPassword" class="input"
                               placeholder="Passwort wiederholen" />
                    </div>

                    <button class="btn btn-primary" style="width:100%;" @onclick="DoChangePassword" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <div class="spinner"></div>
                            <span>Speichere...</span>
                        }
                        else
                        {
                            <span>Passwort ändern</span>
                        }
                    </button>

                    @if (!AppState.MustChangePassword)
                    {
                        <button class="btn btn-ghost" style="width:100%;" @onclick='() => Nav.NavigateTo("/dashboard")'>
                            Zurück zum Dashboard
                        </button>
                    }

                </div>

                <div class="cp-rules">
                    <span>Passwort-Anforderungen:</span>
                    <span class="@(newPassword.Length >= 8 ? "rule-ok" : "rule-bad")">✓ Mind. 8 Zeichen</span>
                    <span class="@(newPassword.Any(char.IsDigit) ? "rule-ok" : "rule-bad")">✓ Mind. 1 Zahl</span>
                    <span class="@(newPassword.Any(c => "!@#$%^&*()_+-=".Contains(c)) ? "rule-ok" : "rule-bad")">✓ Mind. 1 Sonderzeichen</span>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private string oldPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string? errorMsg;
    private string? successMsg;
    private bool isSaving = false;
    private bool _initialized = false;

    private int PasswordStrength => CalcStrength(newPassword);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AppState.InitializeAsync();
        _initialized = true;

        if (!AppState.IsLoggedIn)
        {
            Nav.NavigateTo("/");
            return;
        }

        StateHasChanged();
    }

    private async Task DoChangePassword()
    {
        errorMsg = null;
        successMsg = null;

        if (string.IsNullOrWhiteSpace(oldPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMsg = "Bitte alle Felder ausfüllen!";
            return;
        }

        if (newPassword != confirmPassword)
        {
            errorMsg = "Passwörter stimmen nicht überein!";
            return;
        }

        if (PasswordStrength < 2)
        {
            errorMsg = "Passwort zu schwach! Mind. 8 Zeichen, 1 Zahl, 1 Sonderzeichen.";
            return;
        }

        isSaving = true;
        try
        {
            var (ok, message) = await ApiService.ChangePassword(oldPassword, newPassword, confirmPassword);
            if (ok)
            {
                successMsg = message + " Du wirst weitergeleitet...";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(2000);
                await AppState.LogoutAsync();
                Nav.NavigateTo("/");
            }
            else
            {
                errorMsg = message;
            }
        }
        catch (Exception ex)
        {
            errorMsg = $"Fehler: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private int CalcStrength(string pw)
    {
        if (string.IsNullOrEmpty(pw)) return 0;
        int score = 0;
        if (pw.Length >= 8) score++;
        if (pw.Any(char.IsDigit)) score++;
        if (pw.Any(char.IsUpper)) score++;
        if (pw.Any(c => "!@#$%^&*()_+-=[]{}|".Contains(c))) score++;
        if (pw.Length >= 12) score++;
        if (score <= 1) return 1;
        if (score <= 3) return 2;
        return 3;
    }

    private string GetStrengthColor(int level) => level switch
    {
        1 => "seg-weak",
        2 => "seg-medium",
        3 => "seg-strong",
        _ => "seg-empty"
    };

    private string GetStrengthText(int level) => level switch
    {
        1 => "Schwach",
        2 => "Mittel",
        3 => "Stark",
        _ => ""
    };
}

<style>
    .cp-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
    }

    .cp-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .cp-logo img {
        width: 84px;
        filter: drop-shadow(0 4px 16px var(--blue-glow));
    }

    .cp-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .cp-header p {
        font-size: 13px;
        color: var(--t3);
        line-height: 1.5;
        margin-top: 8px;
    }

    .strength-bar {
        display: flex;
        gap: 5px;
        margin-top: 8px;
    }

    .strength-seg {
        flex: 1;
        height: 4px;
        border-radius: 2px;
        transition: background 0.3s;
    }

    .seg-empty  { background: var(--l4); }
    .seg-weak   { background: var(--err); }
    .seg-medium { background: var(--warn); }
    .seg-strong { background: var(--ok); }

    .strength-label {
        font-size: 11px;
        font-weight: 600;
        margin-top: 5px;
    }

    .strength-label.seg-weak   { color: var(--err); }
    .strength-label.seg-medium { color: var(--warn); }
    .strength-label.seg-strong { color: var(--ok); }

    .cp-rules {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-top: 20px;
        padding: 14px 16px;
        background: var(--l1);
        border: 1px solid var(--edge);
        border-radius: var(--r-md);
        font-size: 12px;
    }

    .cp-rules span:first-child {
        color: var(--t4);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 2px;
    }

    .rule-ok  { color: var(--ok); }
    .rule-bad { color: var(--t4); }

    .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255,255,255,0.2);
        border-top-color: white;
        border-radius: 50%;
        animation: chrono-spin 0.7s linear infinite;
    }
</style>
