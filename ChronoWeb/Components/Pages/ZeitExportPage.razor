@page "/zeitexport"
@using ChronoWeb.Models
@using ChronoWeb.Services
@inject ApiService ApiService
@inject AppState AppState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>CHRONO – Zeiten Export</PageTitle>

@if (!_initialized)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:var(--l0);color:var(--t1);">
        <div>Lade...</div>
    </div>
}
else if (!AppState.IsLoggedIn)
{
    <p>Weiterleitung...</p>
}
else if (!AppState.IsBuchhaltung && !AppState.IsAdmin)
{
    <div class="no-access">
        <h2>Kein Zugriff</h2>
        <p>Diese Seite ist nur für Buchhaltung.</p>
        <button class="btn btn-secondary" @onclick='() => Navigation.NavigateTo("/dashboard")'>Zurück</button>
    </div>
}
else
{
    <div class="chrono-shell">
        <ChronoSidebar />
        <main class="chrono-main">

            <div class="page-head">
                <div>
                    <p class="page-eyebrow">Abrechnung</p>
                    <h1 class="page-title">Zeiten Export</h1>
                    <p class="page-sub">@AppState.VollName · @AppState.Role</p>
                </div>
                <div class="row-end">
                    <button class="btn btn-primary" @onclick="ExportCsv" disabled="@isExporting">
                        @(isExporting ? "Exportieren..." : "CSV Export")
                    </button>
                </div>
            </div>

            <div class="metrics">
                <div class="metric is-primary">
                    <div class="metric-label">Einträge</div>
                    <div class="metric-value">@GetFiltered().Count()</div>
                </div>
                <div class="metric">
                    <div class="metric-label">Gesamtstunden</div>
                    <div class="metric-value">@GetGesamtStunden()<span>h</span></div>
                </div>
            </div>

            <!-- FILTER -->
            <div class="filterbar">
                <span class="filterbar-label">Von:</span>
                <input type="date" @bind="filterVon" class="input" style="width:auto;" />
                <span class="filterbar-label">Bis:</span>
                <input type="date" @bind="filterBis" class="input" style="width:auto;" />
                <input type="text" @bind="filterName" @bind:event="oninput"
                       placeholder="Mitarbeiter suchen..." class="input" style="width:200px;" />
                <button class="btn btn-secondary" @onclick="LoadData">Filtern</button>
                <button class="btn btn-ghost" @onclick="ResetFilter">Reset</button>
            </div>

            <!-- LOADING -->
            @if (isLoading)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Daten werden geladen...</p>
                </div>
            }
            else if (loadError != null)
            {
                <div class="state-box">
                    <h3>Ladefehler</h3>
                    <p>@loadError</p>
                    <button class="btn btn-secondary" @onclick="LoadData">Erneut versuchen</button>
                </div>
            }
            else if (!GetFiltered().Any())
            {
                <div class="state-box">
                    <h3>Keine Buchungen gefunden</h3>
                    <p>Für den gewählten Zeitraum sind keine Zeitbuchungen vorhanden.</p>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Mitarbeiter</th>
                                    <th>Datum</th>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                    <th>Pause</th>
                                    <th>Arbeitsstunden</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in GetFiltered())
                                {
                                    <tr>
                                        <td>@(b.Mitarbeiter?.FullName ?? $"ID {b.FK_MitID}")</td>
                                        <td class="num">@b.CheckInTime.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <span class="time-chip time-in">@b.CheckInTime.ToString("HH:mm")</span>
                                        </td>
                                        <td>
                                            @if (b.CheckOutTime.HasValue)
                                            {
                                                <span class="time-chip time-out">@b.CheckOutTime.Value.ToString("HH:mm")</span>
                                            }
                                            else
                                            {
                                                <span class="time-chip time-run">Aktiv</span>
                                            }
                                        </td>
                                        <td class="num">@b.BreakMinutes min</td>
                                        <td class="num">
                                            @if (b.ArbeitsStunden.HasValue)
                                            {
                                                <span style="color:@(b.ArbeitsStunden >= 8 ? "var(--ok)" : "var(--warn)"); font-weight:600;">
                                                    @b.ArbeitsStunden.Value.ToString("F2")h
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--blue); font-style:italic;">läuft...</span>
                                            }
                                        </td>
                                        <td>
                                            @if (b.CheckOutTime == null)
                                            {
                                                <span class="badge badge-blue">Aktiv</span>
                                            }
                                            else if (b.ArbeitsStunden >= 8)
                                            {
                                                <span class="badge badge-ok">Vollzeit</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warn">Teilzeit</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5">Gesamt:</td>
                                    <td colspan="2" class="num">
                                        @GetGesamtStunden()h
                                        (@GetFiltered().Count() Einträge)
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }

        </main>
    </div>
}

@code {
    private List<TimeBooking> bookings = new();
    private bool isLoading = true;
    private bool _initialized = false;
    private bool isExporting = false;
    private string? loadError;
    private DateTime filterVon = DateTime.Now.AddDays(-30);
    private DateTime filterBis = DateTime.Now;
    private string filterName = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AppState.InitializeAsync();
        _initialized = true;

        if (!AppState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;
        try
        {
            bookings = await ApiService.GetTimeBookings();
        }
        catch (Exception ex)
        {
            bookings = new();
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetFilter()
    {
        filterVon = DateTime.Now.AddDays(-30);
        filterBis = DateTime.Now;
        filterName = "";
        await LoadData();
    }

    private IEnumerable<TimeBooking> GetFiltered()
    {
        return bookings
            .Where(b => b.CheckInTime.Date >= filterVon.Date
                     && b.CheckInTime.Date <= filterBis.Date
                     && (string.IsNullOrEmpty(filterName) ||
                         (b.Mitarbeiter?.FullName ?? "").Contains(filterName, StringComparison.OrdinalIgnoreCase)))
            .OrderByDescending(b => b.CheckInTime);
    }

    private string GetGesamtStunden()
    {
        var total = GetFiltered()
            .Where(b => b.ArbeitsStunden.HasValue)
            .Sum(b => b.ArbeitsStunden ?? 0);
        return total.ToString("F1");
    }

    private async Task ExportCsv()
    {
        isExporting = true;
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Mitarbeiter;Datum;Check-In;Check-Out;Pause (Min);Arbeitsstunden;Status");
            foreach (var b in GetFiltered())
            {
                var name = b.Mitarbeiter?.FullName ?? $"ID {b.FK_MitID}";
                var datum = b.CheckInTime.ToString("dd.MM.yyyy");
                var checkIn = b.CheckInTime.ToString("HH:mm");
                var checkOut = b.CheckOutTime?.ToString("HH:mm") ?? "aktiv";
                var pause = b.BreakMinutes.ToString();
                var stunden = b.ArbeitsStunden?.ToString("F2") ?? "läuft";
                var status = b.CheckOutTime == null ? "Aktiv"
                           : b.ArbeitsStunden >= 8 ? "Vollzeit" : "Teilzeit";
                sb.AppendLine($"{name};{datum};{checkIn};{checkOut};{pause};{stunden};{status}");
            }
            var filename = $"zeiten_{filterVon:yyyyMMdd}_{filterBis:yyyyMMdd}.csv";
            await JS.InvokeVoidAsync("downloadCsv", sb.ToString(), filename);
        }
        finally
        {
            isExporting = false;
        }
    }
}

<style>
    .no-access { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; gap: 12px; background: var(--l0); }
    .no-access h2 { font-size: 20px; color: var(--t1); margin: 0; }
    .no-access p { color: var(--t3); margin: 0; }
</style>
