@page "/dashboard"
@using ChronoWeb.Models
@using ChronoWeb.Services
@inject ApiService ApiService
@inject AppState AppState
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>CHRONO – Dashboard</PageTitle>

@if (!_initialized)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#07091a;color:#e8f0ff;">
        <div>Lade...</div>
    </div>
}
else if (!AppState.IsLoggedIn)
{
    <p>Weiterleitung...</p>
}
else
{
    <div class="chrono-shell">
        <ChronoSidebar />
        <main class="chrono-main">

            <div class="page-head">
                <div>
                    <p class="page-eyebrow">Übersicht</p>
                    <h1 class="page-title">Hallo, @AppState.VollName</h1>
                    <p class="page-sub">Willkommen im CHRONO System – Flughafen Innsbruck</p>
                </div>

            </div>

            @* PASSWORT-WARNUNG *@
            @if (AppState.MustChangePassword)
            {
                <div class="alert alert-err">
                    Du verwendest noch ein temporäres Passwort. Bitte ändere es jetzt!
                    <button class="btn btn-danger btn-sm" style="margin-left:auto;" @onclick='() => Navigation.NavigateTo("/change-password")'>
                        Jetzt ändern
                    </button>
                </div>
            }

            @* OFFENE BUCHUNGEN WARNUNG *@
            @if (offeneBuchungen.Any())
            {
                <div class="alert alert-err">
                    Sie haben <strong>@offeneBuchungen.Count offene Zeitbuchung(en)</strong> ohne Checkout!
                    <button class="btn btn-secondary btn-sm" style="margin-left:auto;" @onclick='() => Navigation.NavigateTo("/meine-zeiten")'>
                        Jetzt prüfen
                    </button>
                </div>
            }

            @* URLAUBSKONTO BANNER *@
            @if (urlaubskonto != null && urlaubskonto.GesamtTage > 0)
            {
                <div class="card" style="margin-bottom:16px;">
                    <div class="card-body">
                        <div class="urlaub-top">
                            <span>Urlaubskonto @urlaubskonto.Jahr</span>
                            <span><strong>@urlaubskonto.RestTage</strong> / @urlaubskonto.GesamtTage Tage verfügbar</span>
                        </div>
                        <div class="urlaub-bar-bg">
                            <div class="urlaub-bar-fill" style="width: @((int)(urlaubskonto.GenommTage * 100m / urlaubskonto.GesamtTage))%"></div>
                        </div>
                    </div>
                </div>
            }

            @* KACHELN *@
            <h3 class="section-title">Ihre Module</h3>
            <div class="card-grid">

                @* IMMER SICHTBAR *@
                <div class="dash-card blue"
                     @onclick='() => Navigation.NavigateTo("/meine-zeiten")'>
                    <div class="card-body">
                        <div class="card-title">Meine Zeiten</div>
                        <div class="card-desc">Arbeitsstunden einsehen</div>
                    </div>
                    <div class="card-arrow">→</div>
                </div>

                <div class="dash-card green"
                     @onclick='() => Navigation.NavigateTo("/urlaub")'>
                    <div class="card-body">
                        <div class="card-title">Urlaub</div>
                        <div class="card-desc">Antrag stellen & Status</div>
                    </div>
                    <div class="card-arrow">→</div>
                </div>

                <div class="dash-card orange"
                     @onclick='() => Navigation.NavigateTo("/zeitkorrektur")'>
                    <div class="card-body">
                        <div class="card-title">Zeitkorrektur</div>
                        <div class="card-desc">Karte vergessen?</div>
                    </div>
                    <div class="card-arrow">→</div>
                </div>

                @* NUR ABTEILUNGSLEITER, HR, ADMIN *@
                @if (AppState.CanApprove)
                {
                    <div class="dash-card orange"
                         @onclick='() => Navigation.NavigateTo("/antraege")'>
                        <div class="card-body">
                            <div class="card-title">Anträge</div>
                            <div class="card-desc">Genehmigen / Ablehnen</div>
                        </div>
                        <div class="card-arrow">→</div>
                    </div>

                    <div class="dash-card teal"
                         @onclick='() => Navigation.NavigateTo("/team-zeiten")'>
                        <div class="card-body">
                            <div class="card-title">Team-Zeiten</div>
                            <div class="card-desc">Übersicht aller Buchungen</div>
                        </div>
                        <div class="card-arrow">→</div>
                    </div>
                }

                @* NUR HR UND ADMIN *@
                @if (AppState.IsHR || AppState.IsAdmin)
                {
                    <div class="dash-card purple"
                         @onclick='() => Navigation.NavigateTo("/mitarbeiter")'>
                        <div class="card-body">
                            <div class="card-title">Mitarbeiter</div>
                            <div class="card-desc">Verwaltung & Stammdaten</div>
                        </div>
                        <div class="card-arrow">→</div>
                    </div>
                }

                @* NUR BUCHHALTUNG: Zeitexport (kein Gehalt) *@
                @if (AppState.IsBuchhaltung)
                {
                    <div class="dash-card teal"
                         @onclick='() => Navigation.NavigateTo("/zeitexport")'>
                        <div class="card-body">
                            <div class="card-title">Zeiten Export</div>
                            <div class="card-desc">Zeitbuchungen exportieren</div>
                        </div>
                        <div class="card-arrow">→</div>
                    </div>
                }

                @* NUR Buchhaltung: Lohnabrechnung *@
                @if (AppState.IsBuchhaltung)
                {
                    <div class="dash-card red"
                         @onclick='() => Navigation.NavigateTo("/lohn")'>
                        <div class="card-body">
                            <div class="card-title">Lohnabrechnung</div>
                            <div class="card-desc">Reports & CSV Export</div>
                        </div>
                        <div class="card-arrow">→</div>
                    </div>
                }

            </div>

            @* INFO ZEILE UNTEN *@
            <div class="info-bar">
                <span>@DateTime.Now.ToString("dddd, dd. MMMM yyyy")</span>
                <span>Eingeloggt als: <strong>@AppState.UserName</strong></span>
            </div>

        </main>
    </div>
}

@code {
    private List<TimeBooking> offeneBuchungen = new();
    private Urlaubskonto? urlaubskonto;
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AppState.InitializeAsync();
        _initialized = true;

        if (!AppState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try { offeneBuchungen = await ApiService.GetOffeneBuchungen(); } catch { }
        try { urlaubskonto = await ApiService.GetMeinUrlaubskonto(); } catch { }
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AppState.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}

<style>
    /* ─── SECTION TITLE ─── */
    .section-title {
        margin: 0 0 14px;
        color: var(--t3);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 600;
    }

    /* ─── MODUL-KACHELN ─── */
    .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .dash-card {
        position: relative;
        border-radius: var(--r-lg);
        padding: 20px;
        cursor: pointer;
        transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s var(--ease);
        display: flex;
        align-items: center;
        gap: 14px;
        color: var(--t1);
        border: 1px solid var(--edge);
        background: linear-gradient(180deg, var(--l3) 0%, var(--l2) 46%);
        box-shadow: var(--sh-1);
    }

    .dash-card:hover {
        transform: translateY(-3px);
        border-color: rgba(255,255,255,0.09);
        box-shadow: var(--sh-3);
    }

    .card-body { flex: 1; }
    .card-title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
    .card-desc { font-size: 12px; color: var(--t3); }

    .card-arrow { font-size: 18px; opacity: 0.3; transition: all 0.25s; }
    .dash-card:hover .card-arrow { transform: translateX(5px); opacity: 0.8; }

    /* KARTE FARBEN */
    .blue   { --card-color: rgba(59,130,246,0.35);  border-left: 3px solid #3b82f6; }
    .green  { --card-color: rgba(16,185,129,0.35);  border-left: 3px solid #10b981; }
    .orange { --card-color: rgba(245,158,11,0.35);  border-left: 3px solid #f59e0b; }
    .teal   { --card-color: rgba(6,182,212,0.35);   border-left: 3px solid #06b6d4; }
    .purple { --card-color: rgba(139,92,246,0.35);  border-left: 3px solid #8b5cf6; }
    .red    { --card-color: rgba(239,68,68,0.35);   border-left: 3px solid #ef4444; }

    /* ─── URLAUBSKONTO-BALKEN ─── */
    .urlaub-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 13px;
        color: var(--t2);
    }

    .urlaub-top strong { color: var(--t1); }

    .urlaub-bar-bg {
        height: 6px;
        background: var(--blue-wash);
        border-radius: 3px;
        overflow: hidden;
    }

    .urlaub-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--blue), var(--blue-lift));
        border-radius: 3px;
        transition: width 0.6s ease;
    }

    /* ─── INFO ZEILE ─── */
    .info-bar {
        padding: 14px 20px;
        background: linear-gradient(180deg, var(--l3), var(--l2));
        border: 1px solid var(--edge);
        border-radius: var(--r-md);
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: var(--t3);
    }

    .info-bar strong { color: var(--t2); }
</style>