@page "/meine-zeiten"
@using ChronoWeb.Models
@using ChronoWeb.Services
@inject ApiService ApiService
@inject AppState AppState
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>CHRONO – Meine Zeiten</PageTitle>

@if (!_initialized)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:var(--l0);color:var(--t1);">
        <div>Lade...</div>
    </div>
}
else if (!AppState.IsLoggedIn)
{
    <p>Weiterleitung...</p>
}
else
{
    <div class="chrono-shell">
        <ChronoSidebar />
        <main class="chrono-main">

            <div class="page-head">
                <div>
                    <p class="page-eyebrow">Zeiterfassung</p>
                    <h1 class="page-title">Meine Zeiten</h1>
                    <p class="page-sub">Buchungen und Arbeitsstunden im Überblick</p>
                </div>
            </div>

            <div class="metrics">
                <div class="metric is-primary rise rise-1">
                    <div class="metric-label">Diese Woche</div>
                    <div class="metric-value">@GetWochenStunden()<span>h</span></div>
                    <div class="metric-note">von 40h Sollzeit</div>
                </div>
                <div class="metric rise rise-2">
                    <div class="metric-label">Diesen Monat</div>
                    <div class="metric-value">@GetMonatsStunden()<span>h</span></div>
                </div>
                <div class="metric is-warn rise rise-3">
                    <div class="metric-label">Überstunden</div>
                    <div class="metric-value">@GetWochenUeberstunden()<span>h</span></div>
                </div>
            </div>

            <!-- CHECK-IN/OUT BOX -->
            <div class="card" style="margin-bottom:20px;">
                <div class="card-body row">
                    <span class="dot @(aktuelleBuchung != null ? "is-live" : "")"></span>
                    <div style="flex:1;">
                        @if (aktuelleBuchung == null)
                        {
                            <span>Nicht eingestempelt</span>
                        }
                        else
                        {
                            <span>Eingestempelt seit @aktuelleBuchung.CheckInTime.ToString("HH:mm") Uhr</span>
                        }
                    </div>
                    @if (aktuelleBuchung == null)
                    {
                        <button class="btn btn-success" @onclick="DoCheckIn" disabled="@isChecking">
                            @(isChecking ? "Bitte warten..." : "Einstempeln")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-danger" @onclick="DoCheckOut" disabled="@isChecking">
                            @(isChecking ? "Bitte warten..." : "Ausstempeln")
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(checkMsg))
                    {
                        <span style="font-size:13px;color:@(checkOk ? "var(--ok)" : "var(--err)")">@checkMsg</span>
                    }
                </div>
            </div>

            <!-- FILTER LEISTE -->
            <div class="filterbar">
                <span class="filterbar-label">Von:</span>
                <input type="date" @bind="filterVon" class="input" style="width:auto;" />
                <span class="filterbar-label">Bis:</span>
                <input type="date" @bind="filterBis" class="input" style="width:auto;" />
                <button class="btn btn-secondary" @onclick="LoadData">Filtern</button>
                <button class="btn btn-ghost" @onclick="ResetFilter">Reset</button>
            </div>

            <!-- LOADING -->
            @if (isLoading)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Daten werden geladen...</p>
                </div>
            }
            else if (loadError != null)
            {
                <div class="state-box">
                    <h3>Fehler beim Laden</h3>
                    <p>@loadError</p>
                    <p>MitarbeiterID: @AppState.MitarbeiterID · API: TimeBooking/mitarbeiter/@AppState.MitarbeiterID</p>
                    <button class="btn btn-secondary" @onclick="LoadData">Erneut versuchen</button>
                </div>
            }
            else if (!bookings.Any())
            {
                <div class="state-box">
                    <h3>Keine Buchungen gefunden</h3>
                    <p>Für den gewählten Zeitraum sind keine Zeitbuchungen vorhanden.</p>
                </div>
            }
            else
            {
                <!-- TABELLE -->
                <div class="card">
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                    <th>Pause</th>
                                    <th>Arbeitsstunden</th>
                                    <th>Überstunden</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in GetFilteredBookings())
                                {
                                    <tr>
                                        <td>
                                            @b.CheckInTime.ToString("dd.MM.yyyy")
                                        </td>
                                        <td>
                                            <span class="time-chip time-in">
                                                @b.CheckInTime.ToString("HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            @if (b.CheckOutTime.HasValue)
                                            {
                                                <span class="time-chip time-out">
                                                    @b.CheckOutTime.Value.ToString("HH:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="time-chip time-run">
                                                    Aktiv
                                                </span>
                                            }
                                        </td>
                                        <td class="num">
                                            @if (b.BreakMinutes == 0)
                                            {
                                                <span style="color:var(--t4);">–</span>
                                            }
                                            else
                                            {
                                                <span>@b.BreakMinutes min</span>
                                            }
                                        </td>
                                        <td class="num">
                                            @if (b.ArbeitsStunden.HasValue)
                                            {
                                                <span style="color:@(b.ArbeitsStunden >= 8 ? "var(--ok)" : "var(--warn)"); font-weight:600;">
                                                    @b.ArbeitsStunden.Value.ToString("F2")h
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--blue); font-style:italic;">läuft...</span>
                                            }
                                        </td>
                                        <td class="num">
                                            @{
                                                var ue = GetUeberstunden(b);
                                            }
                                            @if (ue > 0)
                                            {
                                                <span style="color:var(--warn);font-weight:600;">
                                                    +@ue.ToString("F2")h
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--t4);">–</span>
                                            }
                                        </td>
                                        <td>
                                            @if (b.CheckOutTime == null)
                                            {
                                                <span class="badge badge-blue">Aktiv</span>
                                            }
                                            else if (b.ArbeitsStunden >= 8)
                                            {
                                                <span class="badge badge-ok">Vollzeit</span>
                                                @if (GetUeberstunden(b) > 0)
                                                {
                                                    <span class="badge badge-warn" style="margin-left:4px;">
                                                        +@GetUeberstunden(b).ToString("F1")h
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-warn">Teilzeit</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4">Gesamt:</td>
                                    <td colspan="3" class="num">
                                        @GetGesamtStunden()h
                                        (@GetFilteredBookings().Count() Einträge)
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }

        </main>
    </div>
}

@code {
    private List<TimeBooking> bookings = new();
    private bool isLoading = true;
    private bool _initialized = false;
    private string? loadError;
    private DateTime filterVon = DateTime.Now;
    private DateTime filterBis = DateTime.Now.AddDays(1);

    private TimeBooking? aktuelleBuchung;
    private bool isChecking = false;
    private string checkMsg = "";
    private bool checkOk = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AppState.InitializeAsync();
        _initialized = true;

        if (!AppState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        loadError = null;
        try
        {
            bookings = await ApiService.GetTimeBookingsByMitarbeiter(
                AppState.MitarbeiterID);
            aktuelleBuchung = await ApiService.GetAktuelleBuchung();
        }
        catch (Exception ex)
        {
            bookings = new();
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DoCheckIn()
    {
        isChecking = true; checkMsg = "";
        bool ok = await ApiService.CheckIn(AppState.MitarbeiterID);
        if (ok) { checkMsg = "Erfolgreich eingestempelt!"; checkOk = true; await LoadData(); }
        else { checkMsg = "Fehler beim Einstempeln!"; checkOk = false; }
        isChecking = false; StateHasChanged();
        await Task.Delay(3000); checkMsg = ""; StateHasChanged();
    }

    private async Task DoCheckOut()
    {
        if (aktuelleBuchung == null) return;
        isChecking = true; checkMsg = "";
        bool ok = await ApiService.CheckOut(aktuelleBuchung.TimeID, AppState.MitarbeiterID);
        if (ok) { checkMsg = "Erfolgreich ausgestempelt!"; checkOk = true; aktuelleBuchung = null; await LoadData(); }
        else { checkMsg = "Fehler beim Ausstempeln!"; checkOk = false; }
        isChecking = false; StateHasChanged();
        await Task.Delay(3000); checkMsg = ""; StateHasChanged();
    }

    private async Task ResetFilter()
    {
        filterVon = DateTime.Now;
        filterBis = DateTime.Now.AddDays(1);
        await LoadData();
    }

    private IEnumerable<TimeBooking> GetFilteredBookings()
    {
        return bookings
            .Where(b => b.CheckInTime.Date >= filterVon.Date
                     && b.CheckInTime.Date <= filterBis.Date)
            .OrderByDescending(b => b.CheckInTime);
    }

    private string GetWochenStunden()
    {
        var start = DateTime.Now.AddDays(-(int)DateTime.Now.DayOfWeek + 1);
        var total = bookings
            .Where(b => b.CheckInTime >= start && b.ArbeitsStunden.HasValue)
            .Sum(b => b.ArbeitsStunden ?? 0);
        return total.ToString("F1");
    }

    private string GetMonatsStunden()
    {
        var total = bookings
            .Where(b => b.CheckInTime.Month == DateTime.Now.Month
                     && b.CheckInTime.Year == DateTime.Now.Year
                     && b.ArbeitsStunden.HasValue)
            .Sum(b => b.ArbeitsStunden ?? 0);
        return total.ToString("F1");
    }

    private string GetGesamtStunden()
    {
        var total = GetFilteredBookings()
            .Where(b => b.ArbeitsStunden.HasValue)
            .Sum(b => b.ArbeitsStunden ?? 0);
        return total.ToString("F1");
    }

    private double GetUeberstunden(TimeBooking b)
    {
        if (!b.ArbeitsStunden.HasValue || b.ArbeitsStunden.Value <= 8)
            return 0;
        return Math.Round(b.ArbeitsStunden.Value - 8, 2);
    }

    private string GetWochenUeberstunden()
    {
        var heute = DateTime.Now;
        int diff = (7 + (int)heute.DayOfWeek - (int)DayOfWeek.Monday) % 7;
        var montag = heute.AddDays(-diff).Date;

        var total = bookings
            .Where(b => b.CheckInTime.Date >= montag
                     && b.CheckOutTime.HasValue
                     && b.ArbeitsStunden.HasValue
                     && b.ArbeitsStunden.Value > 8)
            .Sum(b => b.ArbeitsStunden!.Value - 8);

        return Math.Round(Math.Max(0, total), 1).ToString("F1");
    }
}